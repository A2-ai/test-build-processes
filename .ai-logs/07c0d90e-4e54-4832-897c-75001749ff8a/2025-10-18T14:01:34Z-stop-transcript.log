strategy:\n      matrix:\n        include:\n          # x86_64 GNU builds on AlmaLinux 8 (glibc 2.28)\n          - runner: ubuntu-latest\n            target: x86_64-unknown-linux-gnu\n            container: almalinux:8\n            arch: x86_64\n\n          # aarch64 GNU builds on AlmaLinux 8 (glibc 2.28)\n          - runner: ubuntu-latest-arm64\n            target: aarch64-unknown-linux-gnu\n            container: almalinux:8\n            arch: aarch64\n\n    steps:\n      - name: Install dependencies (AlmaLinux)\n        if: ${{ contains(matrix.container, 'almalinux') }}\n        run: |\n          dnf install -y gcc gcc-c++ make git curl tar gzip\n\n      - name: Install Rust\n        run: |\n          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable\n          echo \"$HOME/.cargo/bin\" >> $GITHUB_PATH\n\n      - name: Add Rust target\n        run: |\n          . \"$HOME/.cargo/env\"\n          rustup target add ${{ matrix.target }}\n\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Cargo build\n        run: |\n          . \"$HOME/.cargo/env\"\n          cargo build --release --target ${{ matrix.target }}\n\n      - name: Archive\n        run: |\n          mkdir -p artifacts\n          cp -av target/${{ matrix.target }}/release/test-build-processes .\n          if [ -n \"${{ github.ref_name }}\" ] && [ \"${{ github.ref_type }}\" = \"tag\" ]; then\n            ARTIFACT_NAME=\"test-build-processes-${{ github.ref_name }}-${{ matrix.target }}.tar.gz\"\n          else\n            ARTIFACT_NAME=\"test-build-processes-${{ matrix.target }}.tar.gz\"\n          fi\n          tar -czf \"$ARTIFACT_NAME\" test-build-processes\n          echo \"ARTIFACT_NAME=$ARTIFACT_NAME\" >> $GITHUB_ENV\n\n      - uses: actions/upload-artifact@v4\n        with:\n          name: test-build-processes-${{ github.ref_name }}-${{ matrix.target }}\n          path: ${{ env.ARTIFACT_NAME }}\n          if-no-files-found: error\n          retention-days: 7\n","structuredPatch":[{"oldStart":25,"oldLines":7,"newStart":25,"newLines":7,"lines":["             arch: x86_64"," ","           # aarch64 GNU builds on AlmaLinux 8 (glibc 2.28)","-          - runner: ubuntu-latest-arm64","+          - runner: ubuntu-24.04-arm","             target: aarch64-unknown-linux-gnu","             container: almalinux:8","             arch: aarch64"]}],"userModified":false,"replaceAll":false}}
