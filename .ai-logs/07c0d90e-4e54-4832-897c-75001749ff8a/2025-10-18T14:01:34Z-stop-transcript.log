atrix.target }}.tar.gz\"\n          fi\n          tar -czf \"$ARTIFACT_NAME\" test-build-processes\n          echo \"ARTIFACT_NAME=$ARTIFACT_NAME\" >> $GITHUB_ENV\n\n      - uses: actions/upload-artifact@v4\n        with:\n          name: test-build-processes-${{ github.ref_name }}-${{ matrix.target }}\n          path: ${{ env.ARTIFACT_NAME }}\n          if-no-files-found: error\n          retention-days: 7\n","structuredPatch":[{"oldStart":49,"oldLines":6,"newStart":49,"newLines":16,"lines":["       - name: Checkout repository","         uses: actions/checkout@v4"," ","+      - name: Install Python (for version check)","+        if: ${{ github.ref_type == 'tag' }}","+        run: |","+          dnf install -y python3","+","+      - name: Check version matches tag","+        if: ${{ github.ref_type == 'tag' }}","+        run: |","+          python3 .github/scripts/tag_check.py \"${{ github.ref_name }}\"","+","       - name: Cargo build","         run: |","           . \"$HOME/.cargo/env\""]}],"userModified":false,"replaceAll":false}}
