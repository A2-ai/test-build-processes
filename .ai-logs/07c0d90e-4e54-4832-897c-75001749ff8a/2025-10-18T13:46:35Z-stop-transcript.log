acts\n          cp -av target/${{ matrix.target }}/release/test-build-processes .\n          tar -czf test-build-processes-${{ matrix.target }}.tar.gz test-build-processes\n\n      - uses: actions/upload-artifact@v4\n        with:\n          name: test-build-processes-${{ matrix.target }}\n          path: test-build-processes-${{ matrix.target }}.tar.gz\n          if-no-files-found: error\n          retention-days: 7\n","structuredPatch":[]}}
