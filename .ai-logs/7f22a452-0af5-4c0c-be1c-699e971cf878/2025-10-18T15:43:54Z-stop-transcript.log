--config .goreleaser.yml --snapshot\n          else\n            ~/go/bin/goreleaser release --clean --skip=validate --config .goreleaser.yml\n          fi","newString":"      - name: Run GoReleaser\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: |\n          # Run GoReleaser for this specific architecture\n          # Skip publish so we can collect all artifacts and publish in Create-Release job\n          if [ \"${{ steps.version.outputs.is_snapshot }}\" = \"true\" ]; then\n            ~/go/bin/goreleaser release --clean --skip=validate,publish --config .goreleaser.yml --snapshot\n          else\n            ~/go/bin/goreleaser release --clean --skip=validate,publish --config .goreleaser.yml\n          fi","originalFile":"name: Release with Deb Packages\n\non:\n  push:\n    tags: [\"deb-v*.*.*\"]\n  workflow_dispatch:\n\npermissions:\n  contents: write\n\njobs:\n  # Stage 1: Build binaries on AlmaLinux for both architectures\n  Build-Binaries:\n    runs-on: ${{ matrix.runner }}\n    permissions:\n      contents: read\n    container:\n      image: ${{ matrix.container }}\n    strategy:\n      matrix:\n        include:\n          # x86_64 GNU builds on AlmaLinux 8 (glibc 2.28)\n          - runner: ubuntu-latest\n            target: x86_64-unknown-linux-gnu\n            container: almalinux:8\n            arch: x86_64\n\n          # aarch64 GNU builds on AlmaLinux 8 (glibc 2.28)\n          - runner: ubuntu-24.04-arm\n            target: aarch64-unknown-linux-gnu\n            container: almalinux:8\n            arch: aarch64\n\n    steps:\n      - name: Install dependencies (AlmaLinux)\n        if: ${{ contains(matrix.container, 'almalinux') }}\n        run: |\n          dnf install -y gcc gcc-c++ make git curl tar gzip\n\n      - name: Install Rust\n        run: |\n          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable\n          echo \"$HOME/.cargo/bin\" >> $GITHUB_PATH\n\n      - name: Add Rust target\n        run: |\n          . \"$HOME/.cargo/env\"\n          rustup target add ${{ matrix.target }}\n\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Install Python (for version check)\n        if: ${{ github.ref_type == 'tag' }}\n        run: |\n          dnf install -y python3\n\n      - name: Check version matches tag\n        if: ${{ github.ref_type == 'tag' }}\n        run: |\n          # Strip 'deb-' prefix for version comparison\n          TAG_VERSION=$(echo \"${{ github.ref_name }}\" | sed 's/^deb-//')\n          python3 .github/scripts/tag_check.py \"$TAG_VERSION\"\n\n      - name: Cargo build\n        run: |\n          . \"$HOME/.cargo/env\"\n          cargo build --release --target ${{ matrix.target }}\n\n      - name: Prepare binary for upload\n        run: |\n          mkdir -p artifacts\n          cp target/${{ matrix.target }}/release/test-build-processes artifacts/test-build-processes-${{ matrix.target }}\n\n      - name: Upload binary artifact\n        uses: actions/upload-artifact@v4\n        with:\n          name: binary-${{ matrix.target }}\n          path: artifacts/test-build-processes-${{ matrix.target }}\n          if-no-files-found: error\n          retention-days: 1\n\n  # Stage 2: Use GoReleaser to create .deb packages from the built binaries\n  Package-Deb:\n    needs: [Build-Binaries]\n    runs-on: ${{ matrix.runner }}\n    permissions:\n      contents: write\n    strategy:\n      matrix:\n        include:\n          - runner: ubuntu-latest\n            target: x86_64-unknown-linux-gnu\n            goarch: amd64\n          - runner: ubuntu-24.04-arm\n            target: aarch64-unknown-linux-gnu\n            goarch: arm64\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Strip deb- prefix and create clean tag\n        id: version\n        run: |\n          if [ \"${{ github.ref_type }}\" = \"tag\" ]; then\n            VERSION=$(echo \"${{ github.ref_name }}\" | sed 's/^deb-//')\n            echo \"version=$VERSION\" >> $GITHUB_OUTPUT\n            echo \"is_snapshot=false\" >> $GITHUB_OUTPUT\n            # Create a temporary clean tag for GoReleaser\n            git tag -f \"$VERSION\" || true\n          else\n            echo \"version=0.0.0-snapshot\" >> $GITHUB_OUTPUT\n            echo \"is_snapshot=true\" >> $GITHUB_OUTPUT\n          fi\n\n      - name: Set up Go\n        uses: actions/setup-go@v5\n        with:\n          go-version: '1.22'\n\n      - name: Download binary artifact\n        uses: actions/download-artifact@v4\n        with:\n          name: binary-${{ matrix.target }}\n          path: ./binaries\n\n      - name: Prepare binary for GoReleaser\n        run: |\n          mkdir -p target/${{ matrix.target }}/release\n          cp binaries/test-build-processes-${{ matrix.target }} target/${{ matrix.target }}/release/test-build-processes\n          chmod +x target/${{ matrix.target }}/release/test-build-processes\n\n      - name: Install GoReleaser\n        run: |\n          go install github.com/goreleaser/goreleaser/v2@latest\n\n      - name: Run GoReleaser\n        env:\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: |\n          # Run GoReleaser for this specific architecture\n          if [ \"${{ steps.version.outputs.is_snapshot }}\" = \"true\" ]; then\n            ~/go/bin/goreleaser release --clean --skip=validate --config .goreleaser.yml --snapshot\n          else\n            ~/go/bin/goreleaser release --clean --skip=validate --config .goreleaser.yml\n          fi\n\n      - name: Upload deb artifacts\n        uses: actions/upload-artifact@v4\n        with:\n          name: deb-packages-${{ matrix.target }}\n          path: dist/*.deb\n          if-no-files-found: error\n          retention-days: 7\n\n      - name: Upload archives\n        uses: actions/upload-artifact@v4\n        with:\n          name: archives-${{ matrix.target }}\n          path: dist/*.tar.gz\n          if-no-files-found: error\n          retention-days: 7\n\n  # Stage 3: Create GitHub Release with all artifacts (only on tag push)\n  Create-Release:\n    needs: [Package-Deb]\n    runs-on: ubuntu-latest\n    if: ${{ github.ref_type == 'tag' }}\n    permissions:\n      contents: write\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Ensure artifacts dir exists\n        run: mkdir -p artifacts\n\n      - name: Download all deb packages\n        uses: actions/download-artifact@v4\n        with:\n          pattern: deb-packages-*\n          path: artifacts\n          merge-multiple: true\n\n      - name: Download all archives\n        uses: actions/download-artifact@v4\n        with:\n          pattern: archives-*\n          path: artifacts\n          merge-multiple: true\n\n      - name: List downloaded artifacts\n        run: ls -lah artifacts/\n\n      - name: Generate checksums\n        run: |\n          cd artifacts\n          sha256sum * > checksums.txt\n          cat checksums.txt\n\n      - name: Create GitHub Release\n        uses: softprops/action-gh-release@c062e08bd532815e2082a85e87e3ef29c3e6d191\n        with:\n          name: ${{ github.ref_name }}\n          tag_name: ${{ github.ref_name }}\n          draft: true\n          generate_release_notes: true\n          fail_on_unmatched_files: true\n          body: |\n            Welcome to release ${{ github.ref_name }} of test-build-processes!\n\n            This release includes **Debian packages (.deb)** for easy installation on Debian-based systems.\n\n            **Available packages:**\n            - `test-build-processes_*.deb` - Debian packages with post-install hooks\n            - `test-build-processes_*.tar.gz` - Tarball archives\n\n            **Installation (Debian/Ubuntu):**\n            ```bash\n            # Download the appropriate .deb file for your architecture\n            # For x86_64:\n            sudo dpkg -i test-build-processes_*_amd64.deb\n\n            # For ARM64:\n            sudo dpkg -i test-build-processes_*_arm64.deb\n            ```\n\n            **Build targets:**\n            - `x86_64-unknown-linux-gnu`: Built on AlmaLinux 8 (glibc 2.28) for broad compatibility\n            - `aarch64-unknown-linux-gnu`: Built on AlmaLinux 8 (glibc 2.28) for ARM64 systems\n\n            All binaries are dynamically linked against glibc 2.28+.\n            The .deb packages install the binary to `/usr/local/bin` and include post-installation hooks.\n          token: ${{ secrets.GITHUB_TOKEN }}\n          prerelease: ${{ contains(github.ref, '-pre') || contains(github.ref, '-test') }}\n          files: artifacts/*\n","structuredPatch":[{"oldStart":142,"oldLines":10,"newStart":142,"newLines":11,"lines":["           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}","         run: |","           # Run GoReleaser for this specific architecture","+          # Skip publish so we can collect all artifacts and publish in Create-Release job","           if [ \"${{ steps.version.outputs.is_snapshot }}\" = \"true\" ]; then","-            ~/go/bin/goreleaser release --clean --skip=validate --config .goreleaser.yml --snapshot","+            ~/go/bin/goreleaser release --clean --skip=validate,publish --config .goreleaser.yml --snapshot","           else","-            ~/go/bin/goreleaser release --clean --skip=validate --config .goreleaser.yml","+            ~/go/bin/goreleaser release --clean --skip=validate,publish --config .goreleaser.yml","           fi"," ","       - name: Upload deb artifacts"]}],"userModified":false,"replaceAll":false}}
