{ matrix.container }}\n    strategy:\n      matrix:\n        include:\n          # x86_64 GNU builds on AlmaLinux 8 (glibc 2.28)\n          - runner: ubuntu-latest\n            target: x86_64-unknown-linux-gnu\n            container: almalinux:8\n            arch: x86_64\n\n          # aarch64 GNU builds on AlmaLinux 8 (glibc 2.28)\n          - runner: ubuntu-24.04-arm\n            target: aarch64-unknown-linux-gnu\n            container: almalinux:8\n            arch: aarch64\n\n    steps:\n      - name: Install dependencies (AlmaLinux)\n        if: ${{ contains(matrix.container, 'almalinux') }}\n        run: |\n          dnf install -y gcc gcc-c++ make git curl tar gzip\n\n      - name: Install Rust\n        run: |\n          curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable\n          echo \"$HOME/.cargo/bin\" >> $GITHUB_PATH\n\n      - name: Add Rust target\n        run: |\n          . \"$HOME/.cargo/env\"\n          rustup target add ${{ matrix.target }}\n\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Install Python (for version check)\n        if: ${{ github.ref_type == 'tag' }}\n        run: |\n          dnf install -y python3\n\n      - name: Check version matches tag\n        if: ${{ github.ref_type == 'tag' }}\n        run: |\n          # Strip 'deb-' prefix for version comparison\n          TAG_VERSION=$(echo \"${{ github.ref_name }}\" | sed 's/^deb-//')\n          python3 .github/scripts/tag_check.py \"$TAG_VERSION\"\n\n      - name: Cargo build\n        run: |\n          . \"$HOME/.cargo/env\"\n          cargo build --release --target ${{ matrix.target }}\n\n      - name: Prepare binary for upload\n        run: |\n          mkdir -p artifacts\n          cp target/${{ matrix.target }}/release/test-build-processes artifacts/test-build-processes-${{ matrix.target }}\n\n      - name: Upload binary artifact\n        uses: actions/upload-artifact@v4\n        with:\n          name: binary-${{ matrix.target }}\n          path: artifacts/test-build-processes-${{ matrix.target }}\n          if-no-files-found: error\n          retention-days: 1\n\n  # Stage 2: Use GoReleaser Pro to create .deb packages from pre-built binaries\n  Package-Deb:\n    needs: [Build-Binaries]\n    runs-on: ubuntu-latest\n    permissions:\n      contents: write\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Strip deb- prefix and create clean tag\n        id: version\n        run: |\n          if [ \"${{ github.ref_type }}\" = \"tag\" ]; then\n            VERSION=$(echo \"${{ github.ref_name }}\" | sed 's/^deb-//')\n            echo \"version=$VERSION\" >> $GITHUB_OUTPUT\n            echo \"is_snapshot=false\" >> $GITHUB_OUTPUT\n            # Create a temporary clean tag for GoReleaser\n            git tag -f \"$VERSION\" || true\n          else\n            echo \"version=0.0.0-snapshot\" >> $GITHUB_OUTPUT\n            echo \"is_snapshot=true\" >> $GITHUB_OUTPUT\n          fi\n\n      - name: Download all binary artifacts\n        uses: actions/download-artifact@v4\n        with:\n          pattern: binary-*\n          path: ./artifacts\n          merge-multiple: false\n\n      - name: Prepare prebuilt binaries for GoReleaser\n        run: |\n          mkdir -p dist\n          # Copy x86_64 binary\n          cp artifacts/binary-x86_64-unknown-linux-gnu/test-build-processes-x86_64-unknown-linux-gnu dist/test-build-processes_linux_amd64\n          chmod +x dist/test-build-processes_linux_amd64\n          # Copy aarch64 binary\n          cp artifacts/binary-aarch64-unknown-linux-gnu/test-build-processes-aarch64-unknown-linux-gnu dist/test-build-processes_linux_arm64\n          chmod +x dist/test-build-processes_linux_arm64\n\n      - name: Run GoReleaser Pro\n        uses: goreleaser/goreleaser-action@v6\n        with:\n          distribution: goreleaser-pro\n          version: \"~> v2\"\n          args: release --clean --skip=validate ${{ steps.version.outputs.is_snapshot == 'true' && '--snapshot' || '' }}\n        env:\n          GORELEASER_KEY: ${{ secrets.GORELEASER_KEY }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Upload artifacts\n        if: steps.version.outputs.is_snapshot == 'true'\n        uses: actions/upload-artifact@v4\n        with:\n          name: deb-packages-and-archives\n          path: |\n            dist/*.deb\n            dist/*.tar.gz\n          if-no-files-found: error\n          retention-days: 7\n\n","structuredPatch":[{"oldStart":116,"oldLines":14,"newStart":116,"newLines":22,"lines":[" ","       - name: Prepare prebuilt binaries for GoReleaser","         run: |","-          mkdir -p dist","+          # Create directory structure that GoReleaser expects for prebuilt binaries","+          # Format: dist/{binary}_{os}_{arch}/{ binary}","+          mkdir -p dist/test-build-processes_linux_amd64_v1","+          mkdir -p dist/test-build-processes_linux_arm64_v8.0","+","           # Copy x86_64 binary","-          cp artifacts/binary-x86_64-unknown-linux-gnu/test-build-processes-x86_64-unknown-linux-gnu dist/test-build-processes_linux_amd64","-          chmod +x dist/test-build-processes_linux_amd64","+          cp artifacts/binary-x86_64-unknown-linux-gnu/test-build-processes-x86_64-unknown-linux-gnu dist/test-build-processes_linux_amd64_v1/test-build-processes","+          chmod +x dist/test-build-processes_linux_amd64_v1/test-build-processes","+","           # Copy aarch64 binary","-          cp artifacts/binary-aarch64-unknown-linux-gnu/test-build-processes-aarch64-unknown-linux-gnu dist/test-build-processes_linux_arm64","-          chmod +x dist/test-build-processes_linux_arm64","+          cp artifacts/binary-aarch64-unknown-linux-gnu/test-build-processes-aarch64-unknown-linux-gnu dist/test-build-processes_linux_arm64_v8.0/test-build-processes","+          chmod +x dist/test-build-processes_linux_arm64_v8.0/test-build-processes"," ","+          # List the structure for debugging","+          ls -R dist/","+","       - name: Run GoReleaser Pro","         uses: goreleaser/goreleaser-action@v6","         with:"]}],"userModified":false,"replaceAll":false}}
