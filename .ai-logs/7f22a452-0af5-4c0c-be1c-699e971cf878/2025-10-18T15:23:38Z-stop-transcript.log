  - README.md\n      - LICENSE*\n      - CLAUDE.md\n\nnfpms:\n  - id: test-build-processes-deb\n    package_name: test-build-processes\n    vendor: a2-ai\n    homepage: https://github.com/a2-ai/test-build-processes\n    maintainer: a2-ai Team\n    description: |\n      test-build-processes - A minimal Rust binary application\n      Demonstrates multi-architecture builds and .deb package generation\n    license: MIT\n    formats:\n      - deb\n\n    # Install binary to /usr/local/bin\n    bindir: /usr/local/bin\n\n    # Set file permissions\n    file_name_template: >-\n      {{ .ProjectName }}_\n      {{- .Version }}_\n      {{- .Arch }}\n\n    # Scripts for installation lifecycle\n    scripts:\n      postinstall: scripts/postinstall.sh\n      preremove: scripts/preremove.sh\n\n    # File metadata - include the scripts in the package\n    contents:\n      - src: scripts/postinstall.sh\n        dst: /usr/share/doc/test-build-processes/postinstall.sh\n        type: config\n      - src: scripts/preremove.sh\n        dst: /usr/share/doc/test-build-processes/preremove.sh\n        type: config\n\nchecksum:\n  name_template: 'checksums.txt'\n\nsnapshot:\n  version_template: \"{{ incpatch .Version }}-next\"\n\nchangelog:\n  sort: asc\n  filters:\n    exclude:\n      - '^docs:'\n      - '^test:'\n      - '^ci:'\n      - '^chore:'\n      - Merge pull request\n      - Merge branch\n\n# Release configuration\nrelease:\n  github:\n    owner: a2-ai\n    name: test-build-processes\n  draft: true\n  prerelease: auto\n  name_template: \"{{ .Tag }}\"\n","structuredPatch":[{"oldStart":75,"oldLines":7,"newStart":75,"newLines":7,"lines":["   name_template: 'checksums.txt'"," "," snapshot:","-  version_template: \"{{ incpatch .Version }}-next\"","+  name_template: \"{{ .Tag }}-next\""," "," changelog:","   sort: asc"]}],"userModified":false,"replaceAll":false}}
