:"      - name: Download binary artifact\n        uses: actions/download-artifact@v4\n        with:\n          name: binary-${{ matrix.target }}\n          path: ./binaries\n\n      - name: Install nfpm\n        run: |\n          curl -sfL https://install.goreleaser.com/github.com/goreleaser/nfpm.sh | sh\n          sudo mv ./bin/nfpm /usr/local/bin/\n\n      - name: Create .deb package\n        env:\n          VERSION: ${{ steps.version.outputs.version }}\n          NFPM_ARCH: ${{ matrix.goarch }}\n          BINARY_PATH: binaries/test-build-processes-${{ matrix.target }}\n        run: |\n          mkdir -p dist\n          chmod +x \"$BINARY_PATH\"\n          nfpm package --packager deb --target \"dist/test-build-processes_${VERSION}_${{ matrix.goarch }}.deb\"\n\n      - name: Create tarball archive\n        env:\n          VERSION: ${{ steps.version.outputs.version }}\n        run: |\n          cp binaries/test-build-processes-${{ matrix.target }} test-build-processes\n          chmod +x test-build-processes\n          tar -czf \"dist/test-build-processes_${VERSION}_linux_${{ matrix.goarch }}.tar.gz\" test-build-processes README.md CLAUDE.md"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"cache_creation_input_tokens":776,"cache_read_input_tokens":99743,"cache_creation":{"ephemeral_5m_input_tokens":776,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"}},"requestId":"req_011CUEtTwUMxyUAtqVKyNSMM","type":"assistant","uuid":"7c39ead0-58cb-41c3-a1c6-5a62ce274ccf","timestamp":"2025-10-18T15:19:11.068Z"}
